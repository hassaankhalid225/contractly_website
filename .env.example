# ─────────────────────────────────────────────────────────────
# Contractly environment configuration
# Copy to `.env` and fill in. Every external integration is
# OPTIONAL in development — the app ships deterministic fallbacks
# so it runs end-to-end with zero keys. Add keys for production.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_URL=http://localhost:3000

# Auth — session signing secret (REQUIRED in production).
# A dev default is used if unset. Generate: openssl rand -base64 48
AUTH_SECRET=

# Database (Prisma / PostgreSQL).
# If unset in development, the app falls back to a local SQLite file
# so you can run without provisioning Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contractly

# AI — Anthropic Claude (contract scanner + template generator).
# Without a key, a deterministic mock analysis is returned.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Email — Resend (signature requests, signed-copy delivery).
# Without a key, emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=Contractly <no-reply@contractly.app>

# File storage — S3 / Cloudflare R2.
# Without creds, files are stored on the local filesystem (./.storage).
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payments — Stripe.
# Without keys, checkout runs in mock mode and upgrades instantly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=

# Google OAuth (optional sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
